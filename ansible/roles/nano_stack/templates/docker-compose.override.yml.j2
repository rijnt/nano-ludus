# docker-compose.override.yml — generated by Ludus nano_stack role
services:
  nano-api:
    environment:
      NANOSIEM_WEBHOOK_ALLOW_PRIVATE: "{{ nanosiem_webhook_allow_private | string | lower }}"
      NANOSIEM_WEBHOOK_EGRESS_ALLOWLIST: "{{ nanosiem_webhook_egress_allowlist }}"
  nano-jobs:
    environment:
      NANOSIEM_WEBHOOK_ALLOW_PRIVATE: "{{ nanosiem_webhook_allow_private | string | lower }}"
      NANOSIEM_WEBHOOK_EGRESS_ALLOWLIST: "{{ nanosiem_webhook_egress_allowlist }}"
{% if tailscale_fqdn is defined and tailscale_fqdn | length > 0 and tailscale_cert_cmd is defined and tailscale_cert_cmd.rc == 0 %}
  nginx:
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./config/nginx/nginx.opensource-tls.conf:/etc/nginx/nginx.conf:ro
      - ./config/nginx/ssl:/etc/nginx/ssl:ro
{% endif %}
